# Aug 6 dev site — bypass dashboard SPA fallback for this subtree.
# Without this rule, Cloudflare Pages serves the Captain's Dashboard's
# index.html (the SPA shell) for every path, including our static
# GeoJSON / PNG / manifest.json files.
/dev/aug6-fronts/* /dev/aug6-fronts/:splat 200
/dev/aug6-fronts/classical_gradient/* /dev/aug6-fronts/classical_gradient/:splat 200
/dev/command-receipt-mvp/* /dev/command-receipt-mvp/:splat 200
